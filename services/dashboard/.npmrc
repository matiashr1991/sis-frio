# Installing from the committed package-lock.json (via `npm ci` or a plain
# `npm install` once a lockfile exists) makes npm ignore better-sqlite3's
# "gypfile": false and attempt an unnecessary node-gyp rebuild, which fails
# on machines without a C++ toolchain even though better-sqlite3 already
# ships a matching prebuilt native binding. This is an npm defect, not a
# reason to swap the database driver: skipping lifecycle scripts avoids the
# broken rebuild and lets the bundled prebuild load normally. None of this
# project's other dependencies rely on install/postinstall scripts.
ignore-scripts=true
